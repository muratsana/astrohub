{
  "name": "astrohub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Türkiye'nin astronomi, astrofotoğrafçılık ve astrocamping platformu",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run prerender",
    "preview": "vite preview",
    "build:preview": "vite build --config vite.preview.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "check:preview": "node scripts/check-preview.mjs",
    "test:e2e": "npm run build:preview && node scripts/e2e.mjs",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:rewrites && npm run check:csp && npm run check:budgets && npm run build:preview && npm run check:preview && npm run check:a11y && npm run check:viewports && node scripts/e2e.mjs",
    "db:link": "supabase link --project-ref eoqggvosegjbburyuyba",
    "db:push": "npm run db:link && supabase db push --linked --yes",
    "db:diff": "npm run db:link && supabase db diff --linked",
    "db:migrations": "npm run db:link && supabase migration list --linked",
    "db:types": "supabase gen types typescript --project-id eoqggvosegjbburyuyba",
    "db:seed": "node scripts/seed.mjs",
    "katalog:disa-aktar": "node scripts/katalog-disa-aktar.mjs",
    "functions:deploy": "supabase functions deploy --project-ref eoqggvosegjbburyuyba",
    "prerender": "vite build --ssr src/entry-prerender.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "check:rewrites": "node scripts/vercel-rewrites.mjs --check",
    "check:csp": "node scripts/csp.mjs --check && node scripts/check-csp.mjs",
    "check:rls": "node scripts/check-rls.mjs",
    "check:auth": "node scripts/check-auth-integrity.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:viewports": "node scripts/check-viewports.mjs",
    "check:external": "node scripts/check-external.mjs",
    "storage:photo-cleanup": "node scripts/photo-lifecycle-cleanup.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hookform/resolvers": "^3.10.0",
    "@supabase/supabase-js": "^2.110.5",
    "@tanstack/react-query": "^5.62.7",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.81.0",
    "react-router": "^8.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.0",
    "prettier": "^3.4.2",
    "supabase": "^2.110.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
