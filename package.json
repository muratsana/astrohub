{
  "name": "astrohub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Türkiye'nin astronomi, astrofotoğrafçılık ve astrocamping platformu",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:preview": "vite build --config vite.preview.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "check:preview": "node scripts/check-preview.mjs",
    "test:e2e": "npm run build:preview && node scripts/e2e.mjs",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run check:preview && node scripts/e2e.mjs",
    "db:link": "supabase link --project-ref eoqggvosegjbburyuyba",
    "db:push": "npm run db:link && supabase db push --linked --yes",
    "db:diff": "npm run db:link && supabase db diff --linked",
    "db:migrations": "npm run db:link && supabase migration list --linked",
    "db:types": "supabase gen types typescript --project-id eoqggvosegjbburyuyba",
    "functions:deploy": "supabase functions deploy --project-ref eoqggvosegjbburyuyba"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@hookform/resolvers": "^3.10.0",
    "@supabase/supabase-js": "^2.110.5",
    "@tanstack/react-query": "^5.62.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.81.0",
    "react-router": "^8.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.0",
    "prettier": "^3.4.2",
    "supabase": "^2.110.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
