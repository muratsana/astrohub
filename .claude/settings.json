{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 300,
            "statusMessage": "Bağımlılıklar kuruluyor (npm install)…"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__Supabase",
      "Bash(supabase:*)",
      "Bash(supabase *)",
      "Bash(npx supabase:*)",
      "Bash(npx supabase *)",
      "Bash(npm run:*)",
      "Bash(npm run *)",
      "Bash(npm test:*)",
      "Bash(npm test *)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npx tsc:*)",
      "Bash(npx tsc *)",
      "Bash(npx vitest:*)",
      "Bash(npx vitest *)",
      "Bash(npx eslint:*)",
      "Bash(npx eslint *)",
      "Bash(npx prettier:*)",
      "Bash(npx prettier *)",
      "Bash(git status:*)",
      "Bash(git status *)",
      "Bash(git diff:*)",
      "Bash(git diff *)",
      "Bash(git log:*)",
      "Bash(git log *)",
      "Bash(git show:*)",
      "Bash(git show *)",
      "Bash(git add:*)",
      "Bash(git add *)",
      "Bash(git commit:*)",
      "Bash(git commit *)",
      "Bash(git checkout:*)",
      "Bash(git checkout *)",
      "Bash(git branch:*)",
      "Bash(git branch *)",
      "Bash(git fetch:*)",
      "Bash(git fetch *)",
      "Bash(git push:*)",
      "Bash(git push *)",
      "Read",
      "Glob",
      "Grep"
    ],
    "ask": [
      "mcp__Supabase__create_project",
      "mcp__Supabase__pause_project",
      "mcp__Supabase__restore_project",
      "mcp__Supabase__delete_branch",
      "mcp__Supabase__merge_branch",
      "mcp__Supabase__confirm_cost",
      "Bash(supabase db reset:*)",
      "Bash(npx supabase db reset:*)"
    ]
  }
}
