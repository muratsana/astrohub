{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 300,
            "statusMessage": "Bağımlılıklar kuruluyor (npm install)…"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__Supabase",
      "Bash(supabase:*)",
      "Bash(supabase *)",
      "Bash(npx supabase:*)",
      "Bash(npx supabase *)",
      "Bash(npm run:*)",
      "Bash(npm run *)",
      "Bash(npm test:*)",
      "Bash(npm test *)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npx tsc:*)",
      "Bash(npx tsc *)",
      "Bash(npx vitest:*)",
      "Bash(npx vitest *)",
      "Bash(npx eslint:*)",
      "Bash(npx eslint *)",
      "Bash(npx prettier:*)",
      "Bash(npx prettier *)",
      "Bash(git status:*)",
      "Bash(git status *)",
      "Bash(git diff:*)",
      "Bash(git diff *)",
      "Bash(git log:*)",
      "Bash(git log *)",
      "Bash(git show:*)",
      "Bash(git show *)",
      "Bash(git add:*)",
      "Bash(git add *)",
      "Bash(git commit:*)",
      "Bash(git commit *)",
      "Bash(git checkout:*)",
      "Bash(git checkout *)",
      "Bash(git branch:*)",
      "Bash(git branch *)",
      "Bash(git fetch:*)",
      "Bash(git fetch *)",
      "Bash(git push:*)",
      "Bash(git push *)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git stash:*)",
      "Bash(node:*)",
      "Bash(node *)",
      "Bash(python3:*)",
      "Bash(python3 *)",
      "Bash(curl:*)",
      "Bash(curl *)",
      "Bash(jq:*)",
      "Bash(psql:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(echo:*)",
      "Bash(which:*)",
      "Bash(npx playwright:*)",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "NotebookEdit",
      "TodoWrite",
      "Task"
    ],
    "ask": [
      "mcp__Supabase__create_project",
      "mcp__Supabase__delete_branch",
      "mcp__Supabase__merge_branch",
      "mcp__Supabase__confirm_cost"
    ],
    "deny": [
      "mcp__Supabase__pause_project",
      "mcp__Supabase__restore_project",
      "Bash(supabase db reset:*)",
      "Bash(npx supabase db reset:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)"
    ]
  }
}
